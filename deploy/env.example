# Copy to deploy/.env and fill in values (docker compose loads .env from the project directory
# when you run compose from repo root, or use `docker compose --env-file deploy/.env`).

# Required for the `litellm` Compose profile (proxy forwards to OpenAI).
OPENAI_API_KEY=

# Optional: must match what you pass as LITELLM_API_KEY to the harness (default: sk-anything).
# LITELLM_MASTER_KEY=sk-anything

# Optional interceptor trust-boundary keys. When set, callers must provide matching headers:
# X-Arbiter-Gateway-Key for intercept routes and X-Arbiter-Service-Key for verify/state routes.
# ARBITER_GATEWAY_SHARED_KEY=
# ARBITER_SERVICE_SHARED_KEY=

# Optional interceptor audit sink. When set, interceptor writes structured audit decisions
# to Postgres in addition to stdout logs.
# ARBITER_AUDIT_POSTGRES_DSN=postgres://arbiter:arbiter@postgres:5432/arbiter?sslmode=disable
# ARBITER_AUDIT_POSTGRES_QUEUE=2048

# Optional control-plane API protection key. When set, mutating control-plane APIs require:
# X-Arbiter-Control-Key header.
# CONTROL_PLANE_API_KEY=

# Optional policy root override for the control-plane bundle builder.
# In Docker/Compose, set this to the mounted policy path (default compose uses /policy).
# ARBITER_POLICY_ROOT=/policy

# Optional tenant fence for control-plane mutations.
# When set, mutating control-plane APIs require X-Arbiter-Tenant-ID to match.
# ARBITER_TENANT_ID=default

# Optional control-plane RBAC for mutation endpoints.
# When enabled, callers must include X-Arbiter-Role with sufficient privileges.
# Valid roles: viewer, editor, approver, admin.
# ARBITER_CONTROL_PLANE_ENFORCE_RBAC=true
# ARBITER_CONTROL_PLANE_DEFAULT_ROLE=viewer

# Bundle distribution service token used by OPA to fetch control-plane artifacts.
# Must match ARBITER_BUNDLE_SERVICE_TOKEN in compose/runtime.
# ARBITER_BUNDLE_SERVICE_TOKEN=dev-bundle-token
# ARBITER_BUNDLE_SERVICE_TOKEN_SCOPES=bundle:read

# Bundle signature bootstrap configuration. In Postgres mode, control-plane
# persists signing keys and rotation in `signing_keys`, but these env values
# still seed the initial bootstrap key. In fallback mode, they are used directly.
# Prefer RS256: only the control plane gets this PEM-encoded RSA private key;
# OPA/verifiers are configured separately with its public key.
# ARBITER_BUNDLE_SIGNING_ALGORITHM=RS256
# ARBITER_BUNDLE_SIGNING_KEY_ID=arbiter_bundle_rs256
# ARBITER_BUNDLE_SIGNING_SCOPE=read
# ARBITER_BUNDLE_SIGNING_SECRET=-----BEGIN PRIVATE KEY-----...
# OPA/verifiers get this separate value, never the private signing key. For
# RS256 it is the matching PEM-encoded public key; for HS256 it must equal the
# signing secret. The Compose OPA service reads this value directly.
# ARBITER_BUNDLE_VERIFYING_KEY=-----BEGIN PUBLIC KEY-----...
# HS256 remains available for local development and existing deployments.
# In production, the control plane encrypts persisted signing keys with AES-256-GCM.
# Supply a unique base64-encoded 32-byte key from your secret manager, for example:
#   openssl rand -base64 32
# ARBITER_SIGNING_KEY_ENCRYPTION_KEY=
# This is required by default when NODE_ENV=production. Set this only to true
# in non-production environments to enforce the same behavior there.
# ARBITER_REQUIRE_SIGNING_KEY_ENCRYPTION=true

# Optional direct workload identity for the HTTP interceptor. With either mode
# configured, verified tenant/subject replace envelope-supplied tenant and actor
# before OPA evaluation and permit issuance. Prefer OIDC RS256 in production.
# ARBITER_INTERCEPTOR_OIDC_JWKS_URL=https://issuer.example/.well-known/jwks.json
# ARBITER_INTERCEPTOR_OIDC_ISSUER=https://issuer.example
# ARBITER_INTERCEPTOR_OIDC_AUDIENCE=arbiter-interceptor
# ARBITER_INTERCEPTOR_OIDC_JWKS_CACHE_TTL=5m
# Internal gateway alternative:
# ARBITER_INTERCEPTOR_JWT_SECRET=
# ARBITER_INTERCEPTOR_JWT_ISSUER=arbiter
# ARBITER_INTERCEPTOR_JWT_AUDIENCE=arbiter-interceptor
# Fail closed if neither workload identity mode is configured (recommended for enterprise):
# ARBITER_REQUIRE_WORKLOAD_IDENTITY=true

# Execution permits use HS256 locally. For enterprise executor isolation, use
# RS256 (RSA-2048 or stronger) and inject this PEM private key only into the interceptor/MCP gateway.
# Isolated executors can use executorauth.NewVerifierWithRS256PublicKeys with
# the matching public key and therefore never receive permit-signing material.
# ARBITER_TOKEN_ACTIVE_KID=permit-rs256-2026
# ARBITER_TOKEN_RS256_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...

# Opt into the strict interceptor production baseline. Startup then requires
# workload identity, RS256 permit signing, Redis-backed replay/state, durable
# Postgres audit, and a service-boundary key.
# ARBITER_PRODUCTION_MODE=true

# Control-plane live policy validation target. Production URL overrides are
# disabled by default; these server-side credentials are sent only to ARBITER_URL.
# ARBITER_URL=http://arbiter:8080
# ARBITER_POLICY_TEST_GATEWAY_KEY=
# ARBITER_POLICY_TEST_BEARER_TOKEN=
# ARBITER_POLICY_TEST_TIMEOUT_MS=10000
# ARBITER_ALLOW_TEST_URL_OVERRIDE=false

# Optional KMS/HSM signer integration. When configured, the control plane sends
# only the JWT signing input to this HTTPS endpoint and never loads a bundle
# private key. The signer must return {"signature":"<base64url RS256 signature>"}.
# ARBITER_BUNDLE_SIGNER_URL=https://bundle-signer.internal/v1/sign
# ARBITER_BUNDLE_SIGNER_TOKEN=
# ARBITER_BUNDLE_SIGNER_TIMEOUT_MS=3000

# Capability grants: prefer RS256 so the control plane is the only holder of
# signing material. Give the private key below only to the control plane; give
# the matching public key only to MCP gateways. The gateway fails closed if
# RS256 is selected without a valid public key.
# ARBITER_CAPABILITY_ALGORITHM=RS256
# ARBITER_CAPABILITY_KID=capability-rs256-2026
# ARBITER_CAPABILITY_ISSUER=arbiter
# ARBITER_CAPABILITY_AUDIENCE=arbiter-capability
# ARBITER_CAPABILITY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
# ARBITER_CAPABILITY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
# Keep up to seven prior verification keys during a rotation. This is a JSON
# map of key ID to PEM, so embedded newlines must be JSON-escaped:
# ARBITER_CAPABILITY_ADDITIONAL_PUBLIC_KEYS_JSON={"capability-rs256-2025":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"}
# ARBITER_REQUIRE_CAPABILITY=true
# HS256 compatibility / local development only:
# ARBITER_CAPABILITY_SECRET=

# The same ARBITER_PRODUCTION_MODE switch also protects the MCP gateway. Its
# strict baseline requires workload identity, RS256 execution permits, Redis,
# Postgres audit, both gateway/service boundary keys, and RS256 capabilities.
